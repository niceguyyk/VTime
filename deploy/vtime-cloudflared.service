[Unit]
Description=VTime Cloudflare Tunnel
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/vtime/cloudflared.token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
